# Allowlist: the build context is only what the image needs. Everything else
# (.env files, node_modules from the host, contracts/ and its library checkouts,
# data/, output/, docs, .git) never reaches the daemon.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.json
!mikro-orm.config.ts
!api/
!frontend/

# Within the allowed trees: tests and per-workstream snapshots stay out.
api/**/*.test.ts
api/migrations/.snapshot-sportsarc_*.json
frontend/vendor/esbuild-w3s-browser-shim.js
**/.DS_Store
**/*.log
