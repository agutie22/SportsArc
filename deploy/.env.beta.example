# SportsArc beta: every variable the stack in deploy/compose.yml reads.
#
# Local (your machine): deploy/local.sh up copies this to deploy/.env and
#   fills in the three generated secrets. The defaults below ARE local mode.
# VPS: bootstrap-vps.sh copies it to /opt/sportsarc/.env (mode 600) with the
#   secrets generated; then change the lines marked "VPS:".
#
# Never commit a filled-in copy: .env files are gitignored.

# ── Stack ───────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=sportsarc-beta
# db: bundled Postgres. observability: Grafana, Loki, Alloy, Prometheus.
# tunnel: public https URL for phone testing (local only). s3: off-site backups.
COMPOSE_PROFILES=db,observability
# VPS: COMPOSE_PROFILES=db,observability

# App image. Local builds sportsarc:local from this checkout; on the VPS
# deploy.sh sets these per release (ghcr.io/<owner>/sportsarc:<commit sha>).
APP_IMAGE=sportsarc
APP_TAG=local
# Per app container. Two containers + everything else stay under 4 GB.
APP_MEMORY=384m

# ── Web (Caddy) ─────────────────────────────────────────────────────────
# Local: plain http on http://localhost:8080 (browsers treat localhost as a
# secure context, so geolocation works there; phones need the tunnel).
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# VPS: your domain, no scheme; Caddy gets a Let's Encrypt certificate.
# DOMAIN=beta.example.com
# SITE_ADDRESS=beta.example.com
# HTTP_PORT=80
# HTTPS_PORT=443
# Extra Caddy global options. VPS: "email you@example.com" (expiry notices).
# To test HTTPS locally: SITE_ADDRESS=localhost and CADDY_GLOBAL_OPTIONS=local_certs,
# then https://localhost:8443 (curl -k; the CA is Caddy's own).
CADDY_GLOBAL_OPTIONS=
# App containers Caddy balances over. Add app3:3000 when you add app3.
APP_UPSTREAMS=app1:3000 app2:3000
# Caddy's active health check: 200 when ready, 503 while draining or when
# the database is down. (/health only says the process is up.)
HEALTH_PATH=/health/ready

# ── App ─────────────────────────────────────────────────────────────────
# production everywhere except a laptop without a Brevo key (see Email).
NODE_ENV=production
# Graceful restarts: report not-ready, wait for Caddy to notice, then drain.
SHUTDOWN_DRAIN_DELAY_MS=5000
SHUTDOWN_TIMEOUT_MS=20000
# HMAC key for session cookies and OTP hashes. Generated for you; keep it
# secret, and changing it signs everyone out. (openssl rand -hex 32)
SESSION_SECRET=
# Secure cookies need https. Local http: 0. VPS and anything behind https: 1.
COOKIE_SECURE=0
# VPS: COOKIE_SECURE=1

# ── Database ────────────────────────────────────────────────────────────
# Bundled Postgres (profile "db"). The password is generated for you; keep it
# hex so it is safe inside a URL.
POSTGRES_USER=sportsarc
POSTGRES_PASSWORD=
POSTGRES_DB=sportsarc
# A managed database instead: set DATABASE_URL and drop "db" from
# COMPOSE_PROFILES. Leave it unset to use the bundled one.
# DATABASE_URL=postgresql://user:password@host:5432/sportsarc?sslmode=require

# ── Backups ─────────────────────────────────────────────────────────────
# Nightly pg_dump into BACKUP_DIR (relative to this file), 7 daily + 4 weekly.
BACKUP_DIR=./backups
BACKUP_HOUR_UTC=3
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
# Off-site copy: add "s3" to COMPOSE_PROFILES and fill these in. Any
# S3-compatible bucket (AWS, Backblaze B2, Cloudflare R2, Wasabi).
S3_BUCKET=
S3_PREFIX=sportsarc
# Empty for AWS; e.g. https://<account>.r2.cloudflarestorage.com for R2.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SYNC_INTERVAL_MIN=60

# ── Observability (profile "observability") ────────────────────────────
# Grafana on http://localhost:3001 (VPS: through an SSH tunnel, see deploy/README.md).
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=http://localhost:3001
# Alerts go to Telegram. Create the bot with @BotFather and find the chat ID
# as deploy/README.md shows. Empty values: alerts show in Grafana but go nowhere.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# telegram | discord | email. Empty: the first one that is filled in.
ALERT_CHANNEL=
# Alternatives:
# ALERT_EMAIL_TO=you@example.com
# GF_SMTP_ENABLED=true
# GF_SMTP_HOST=smtp-relay.brevo.com:587
# GF_SMTP_USER=
# GF_SMTP_PASSWORD=
# GF_SMTP_FROM_ADDRESS=alerts@example.com
# DISCORD_WEBHOOK_URL=

# ── Email (Brevo) ───────────────────────────────────────────────────────
# Login codes are emailed through Brevo. In production the app will not
# start without EMAIL_PROVIDER=brevo, BREVO_API_KEY and EMAIL_FROM.
# EMAIL_FROM must be a sender verified in Brevo (Senders); a Gmail address
# works while SportsArc has no mail domain.
# Laptop without a key yet: deploy/local.sh sets NODE_ENV=development and
# EMAIL_PROVIDER=console, and codes print to the app log (deploy/local.sh otp).
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_FROM="SportsArc <you@example.com>"
# EMAIL_TIMEOUT_MS=8000

# ── Private beta ────────────────────────────────────────────────────────
# Only invited emails can create an account; admins invite from the account
# menu ("Invite testers"). An admin email may sign up without an invite.
BETA_INVITE_ONLY=true
ADMIN_EMAILS=

# ── Error tracking and logs ─────────────────────────────────────────────
# Self-hosted: app errors are log lines, collected by Alloy into Loki and
# alerted on by Grafana. No external service. The app will read:
# LOG_LEVEL=info

# ── Circle wallets (optional; login works without them) ────────────────
CIRCLE_APP_ID=
CIRCLE_API_KEY=

# ── Chain (testnet only) ──────────────────────────────────────
# Deploying the contracts and filling in the addresses: deploy/CONTRACTS.md.
# The relayer key must be a throwaway testnet key, never one with real funds.
BUYER_CHAIN=arcTestnet
# BUYER_RPC_URL=
WEB3_CHAIN=arcTestnet
WEB3_RPC_URL=
TESTNET_PRIVATE_KEY=
# EventVault's payout router (Gateway payouts): its own throwaway key, never
# the relayer's. Unset turns routed payouts off.
PAYOUT_PRIVATE_KEY=
# WEB3_USDC_ADDRESS=               # unset: Arc USDC 0x3600000000000000000000000000000000000000
# WALLET_RPC_URL_5042002=
RECORD_CONTRACT_ADDRESS=
RECORD_INTERVAL_MIN=1
EVENT_VAULT_ADDRESS=              # paid events (DeployEvents.s.sol); idle until set
# CCTP_ARC_RPC_URL=
# CCTP_HYPEREVM_RPC_URL=
# CCTP_IRIS_URL=https://iris-api-sandbox.circle.com
