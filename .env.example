# SportsArc
#
#   docker compose up -d postgres
#   pnpm migration:up
#   pnpm run dev

# Postgres (local compose binds 127.0.0.1:5435 so XLounge :5432, SitePeace :5433, and other local DBs stay free)
DATABASE_URL=postgresql://sportsarc:sportsarc@127.0.0.1:5435/sportsarc
POSTGRES_USER=sportsarc
POSTGRES_PASSWORD=sportsarc
POSTGRES_DB=sportsarc

# Circle user-controlled wallets (optional — login works without these)
CIRCLE_APP_ID=your-app-id-from-circle-console
CIRCLE_API_KEY=TEST_API_KEY:...

# HMAC secret for the httpOnly sportsarc_session cookie (also used to hash OTP codes)
SESSION_SECRET=generate-a-long-random-string

# ── Login codes by email (api/auth/mailer.ts) ──────────────────────────────
# EMAIL_PROVIDER picks who delivers login codes:
#   console  development default: codes print to the API terminal as
#            [otp] email you@example.com 123456. Refused in production
#            (NODE_ENV=production): the API will not start with it.
#   brevo    the beta's provider. Use it while SportsArc has no mail domain:
#            Brevo sends from a single verified sender address (verify it in
#            Brevo under Senders), so EMAIL_FROM can be e.g. a Gmail address.
#   resend   use once a domain is verified in Resend. Without a domain Resend
#            only delivers to your own account address, so testers get nothing.
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=                    # Brevo > SMTP & API > API keys (xkeysib-...)
# RESEND_API_KEY=                   # re_...
# EMAIL_FROM="SportsArc <you@example.com>"   # must be the verified sender (Brevo) or on the verified domain (Resend)
# EMAIL_TIMEOUT_MS=8000             # per-send timeout
# BREVO_API_URL= / RESEND_API_URL=  # tests only; loopback addresses only
#
# Phone/SMS codes: no SMS sender exists yet, so the app does not offer phone
# login. The API path remains; outside production it prints to the terminal.

# ── Sign-in screen ──────────────────────────────────────────────────────────
# A user id whose public record the sign-in screen links to ("See a verified
# record"), so a visitor can see one without an account. Pick an adult whose
# record is public; leave unset to show only the map link.
# SHOWCASE_RECORD=

# ── Private beta (api/auth/invites.ts) ─────────────────────────────────────
# With BETA_INVITE_ONLY=true only invited emails can create an account;
# existing accounts always sign in. Admins (ADMIN_EMAILS, comma-separated)
# manage invites from "Invite testers" in the account menu, or with
#   node --env-file=.env --import=tsx scripts/invite.ts add <email> [note] | list | remove <email>
# An admin email may sign up without an invite.
# BETA_INVITE_ONLY=true
# ADMIN_EMAILS=you@example.com

# Data ingestion. The CSV source needs nothing and works out of the box.
#
# MaxPreps has no public API and its robots.txt disallows /school/, /team/,
# /scores/ and /discovery/ for every crawler — which is where rosters and
# stats live. So the adapter requires a licensed feed from CBS Sports and
# refuses to run without one. Even when these are set, any URL robots.txt
# disallows is still refused.
# MAXPREPS_FEED_URL=https://feed.example.com/athletes
# MAXPREPS_API_KEY=

# Chain used for wallet USDC balance reads (defaults in api/circle/chain-config.ts)
BUYER_CHAIN=arcTestnet
# BUYER_RPC_URL=https://rpc.testnet.arc.io

# PORT=3000
# COOKIE_SECURE=1

# ── Logs (api/ops/log.ts) ─────────────────────────────────────────────────
# LOG_FORMAT=json|pretty   json: one JSON object per line on stdout, for
#                          Loki. Defaults to json when NODE_ENV=production,
#                          pretty otherwise.
# LOG_LEVEL=info           debug | info | warn | error. debug adds access
#                          lines for /health, /health/ready and static files.

# Money on Arc (payments, verified check-ins, paid events). The
# minimum to switch it all on, after deploying with contracts/script/
# DeployRecord.s.sol (and DeployEvents.s.sol for paid events; see
# deploy/CONTRACTS.md):
#   WEB3_CHAIN=arcTestnet
#   TESTNET_PRIVATE_KEY=0x...             # throwaway relayer; fund it with test USDC (gas too)
#   PAYOUT_PRIVATE_KEY=0x...              # throwaway payout wallet (routed payouts); ~$1 of test USDC for gas
#   WEB3_USDC_ADDRESS=0x3600000000000000000000000000000000000000
#   EVENT_VAULT_ADDRESS=0x...             # paid events: entry fees and host prizes
#   RECORD_CONTRACT_ADDRESS=0x...           # the verified record (one entry per check-in)

# Web3 workstreams. Testnet only.
# WEB3_CHAIN=arcTestnet
# WEB3_RPC_URL=
# WALLET_RPC_URL_5042002=           # else WEB3_RPC_URL, else Arc's public RPC
# TESTNET_PRIVATE_KEY=              # throwaway relayer key, never real funds
# PAYOUT_PRIVATE_KEY=               # Gateway payout wallet: EventVault's payout router, its own
#                                   # throwaway key (never the relayer's); unset turns routed payouts off
# WEB3_USDC_ADDRESS=               # unset: Arc USDC 0x3600…0000
# RECORD_CONTRACT_ADDRESS=
# RECORD_INTERVAL_MIN=1             # how often closed games are written to the record
# RECORD_MAX_IN_FLIGHT=10           # record transactions unconfirmed at once
# CCTP withdrawals from Arc to the testnets in api/web3/cctp/config.ts,
# HyperEVM included. Optional; defaults are the public RPCs and Circle's
# Iris sandbox. Circle submits the mint; nothing is signed on the destination.
# CCTP_ARC_RPC_URL=
# CCTP_HYPEREVM_RPC_URL=            # read RPC when a withdrawal's destination is HyperEVM
# CCTP_IRIS_URL=https://iris-api-sandbox.circle.com
# EVENT_VAULT_ADDRESS=              # DeployEvents.s.sol; idle until set
# DeployEvents settings (optional; defaults are 1%, 2¢ gas fee, 1h window):
# DEPLOY_FEE_BPS=100
# DEPLOY_GAS_FEE=20000              # USDC base units (6 decimals); an entry costs ~0.6–1.1¢ in gas
# DEPLOY_CORRECTION_WINDOW=3600
# Roles kept off the server keys (TESTNET_PRIVATE_KEY, PAYOUT_PRIVATE_KEY):
# the deploy refuses an owner or treasury on either, and a payout router
# that is the relayer. Use wallets you hold.
# DEPLOY_OWNER=                     # owns both contracts: drops a leaked server key as a record writer,
#                                   # replaces EventVault's signer after a day's notice
# DEPLOY_PAYOUT_ROUTER=             # else the address of PAYOUT_PRIVATE_KEY
# DEPLOY_TREASURY=                  # receives the platform's cut of forfeits and event fees
# ARC_EXPLORER_URL=https://explorer.testnet.arc.io   # where pnpm contracts verifies source

# ── Pro markets: Gemini prediction markets on the sport pages (api/markets) ──
# Market data is public and needs nothing. GEMINI_TRADING picks what a buy does:
#   practice  (default outside production) fills at the live Gemini price into
#             a practice account kept here: no Gemini account, no money.
#   oauth     each user connects their own Gemini account. Needs an OAuth app
#             from Gemini (API Settings; sandbox apps activate at once,
#             production ones after Gemini's review). US accounts only.
#   demo-key  one shared sandbox API key for everyone. Sandbox only.
#   off       (default in production) no Pro markets.
# Gemini's sandbox lists no sports markets (checked 2026-11-16), so a demo
# trades sports in practice mode on production prices.
# GEMINI_TRADING=practice
# GEMINI_PRACTICE_START=1000        # dollars a practice account starts with
# GEMINI_DATA_ENV=production        # where practice reads prices: production | sandbox
# GEMINI_ENV=sandbox                # where real orders go (oauth, demo-key): sandbox | production
# GEMINI_CLIENT_ID=
# GEMINI_CLIENT_SECRET=
# GEMINI_REDIRECT_URI=http://localhost:3000/api/markets/callback
# GEMINI_TOKEN_KEY=                 # 32 random bytes, base64: openssl rand -base64 32
# GEMINI_AUTH_URL=                  # override Gemini's OAuth host (defaults per GEMINI_ENV)
# GEMINI_TOKEN_BODY=form            # form | json: how the token endpoint is sent
# GEMINI_PM_BODY=payload            # payload | json: see api/markets/gemini.ts
# GEMINI_DEMO_KEY=                  # sandbox API key with the Trader role
# GEMINI_DEMO_SECRET=
