pragma solidity ^0.8.28;

/// @notice Entry hashes for SportsArcRecord, one function per kind. An entry
///         hash is keccak256(abi.encode(kindTag, ...facts)), and every
///         encoding starts with its kind tag, so an entry of one kind can
///         never pass as another.
/// @dev    The TypeScript side is api/web3/record/hashes.ts. Change both
///         together; test/SportsArcRecord.t.sol pins vectors generated by
///         api/web3/record/check.ts.
///
///         A kind tag is keccak256 of the kind's name ("checkin"). A kind's
///         encoding never changes: a different layout is a new kind with a
///         new name.
///
///         Ids are hashed, never written raw, and no personal data is used:
///           game    = keccak256(bytes(lowercase game UUID))   (api/web3/ids.ts)
///           userKey = keccak256(bytes(lowercase user UUID))
///           player  = keccak256(abi.encode(userKey, salt)), a fresh random salt per entry
///         The salt stays off chain with the server and the player, so a
///         player code cannot be linked to a user by hashing known user ids.
library RecordHash {
    /// Kind tag for a pickup-game check-in inside the court's geofence.
    bytes32 internal constant CHECKIN = keccak256("checkin");

    /// Kind tag for a seat still held when check-in closed, with no check-in.
    bytes32 internal constant NOSHOW = keccak256("noshow");

    /// abi.encode(bytes32 kind, bytes32 game, bytes32 player, uint64 checkedInAt)
    function checkIn(bytes32 game, bytes32 player, uint64 checkedInAt) internal pure returns (bytes32) {
        return keccak256(abi.encode(CHECKIN, game, player, checkedInAt));
    }

    /// abi.encode(bytes32 kind, bytes32 game, bytes32 player, uint64 closedAt)
    function noShow(bytes32 game, bytes32 player, uint64 closedAt) internal pure returns (bytes32) {
        return keccak256(abi.encode(NOSHOW, game, player, closedAt));
    }

    /// Kind tag for what a game was: its sport, venue, start and host.
    bytes32 internal constant GAME = keccak256("game");

    /// Kind tag for one seat's final result.
    bytes32 internal constant RESULT = keccak256("result");

    /// side and winningSide when there is none.
    uint8 internal constant NO_SIDE = 255;

    /// abi.encode(bytes32 kind, bytes32 game, bytes32 sport, bytes32 venue, uint64 startsAt, bytes32 host)
    /// sport = keccak256(lowercase sport), venue = keccak256(lowercase venue UUID),
    /// host = playerCode(userKey(host), salt).
    function game(bytes32 gameKey, bytes32 sport, bytes32 venue, uint64 startsAt, bytes32 host)
        internal
        pure
        returns (bytes32)
    {
        return keccak256(abi.encode(GAME, gameKey, sport, venue, startsAt, host));
    }

    /// abi.encode(bytes32 kind, bytes32 game, bytes32 player, uint8 side, uint8 outcome, uint8 winningSide, uint64 finalAt)
    /// outcome: 0 win, 1 draw, 2 not played. side and winningSide are 0 or 1, or NO_SIDE.
    function result(bytes32 gameKey, bytes32 player, uint8 side, uint8 outcome, uint8 winningSide, uint64 finalAt)
        internal
        pure
        returns (bytes32)
    {
        return keccak256(abi.encode(RESULT, gameKey, player, side, outcome, winningSide, finalAt));
    }

    /// Kind tag for the host's word on whether a player was there.
    bytes32 internal constant PRESENCE = keccak256("presence");

    /// abi.encode(bytes32 kind, bytes32 game, bytes32 player, uint8 present, uint64 finalAt)
    /// present: 1 here, 0 not here.
    function presence(bytes32 gameKey, bytes32 player, uint8 present, uint64 finalAt) internal pure returns (bytes32) {
        return keccak256(abi.encode(PRESENCE, gameKey, player, present, finalAt));
    }

    /// Kind tag for a team's final standing in a season.
    bytes32 internal constant STANDING = keccak256("standing");

    /// Kind tag for a player on a team that season.
    bytes32 internal constant MEMBER = keccak256("member");

    /// Kind tag for a season: who ran it and its whole table.
    bytes32 internal constant SEASON = keccak256("season");

    /// One value for a list of entry hashes: keccak256 of them concatenated, in order.
    function listHash(bytes32[] memory hashes) internal pure returns (bytes32) {
        return keccak256(abi.encodePacked(hashes));
    }

    /// abi.encode(bytes32 kind, bytes32 season, bytes32 team, uint16 wins, uint16 losses, uint16 ties, uint16 place, bytes32 results, uint64 finalAt)
    /// season, team = keccak256(lowercase UUID); results = listHash of the result hashes it counts, sorted.
    function standing(
        bytes32 seasonKey,
        bytes32 teamKey,
        uint16 wins,
        uint16 losses,
        uint16 ties,
        uint16 place,
        bytes32 results,
        uint64 finalAt
    ) internal pure returns (bytes32) {
        return keccak256(abi.encode(STANDING, seasonKey, teamKey, wins, losses, ties, place, results, finalAt));
    }

    /// abi.encode(bytes32 kind, bytes32 season, bytes32 team, bytes32 player, uint64 finalAt)
    function member(bytes32 seasonKey, bytes32 teamKey, bytes32 player, uint64 finalAt) internal pure returns (bytes32) {
        return keccak256(abi.encode(MEMBER, seasonKey, teamKey, player, finalAt));
    }

    /// abi.encode(bytes32 kind, bytes32 season, bytes32 organizer, bytes32 standings, uint64 finalAt)
    /// organizer = keccak256(lowercase organization UUID); standings = listHash of standing hashes in place order.
    function season(bytes32 seasonKey, bytes32 organizer, bytes32 standings, uint64 finalAt) internal pure returns (bytes32) {
        return keccak256(abi.encode(SEASON, seasonKey, organizer, standings, finalAt));
    }

    /// A player's code for one entry: a salted hash of their user key, opened by revealing (userKey, salt).
    function playerCode(bytes32 userKey, bytes32 salt) internal pure returns (bytes32) {
        return keccak256(abi.encode(userKey, salt));
    }
}
